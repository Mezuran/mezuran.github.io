---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="404 | Page Not Found">
  <div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6">
    <div class="text-center">
      <h1 class="text-6xl sm:text-8xl font-bold text-gray-800 mb-4">404</h1>
      <p class="text-lg sm:text-xl text-gray-400 mb-8">This page doesn't exist.</p>
      <a
        href="/"
        class="px-6 py-3 bg-white text-gray-900 rounded-lg font-medium hover:bg-gray-200 transition-all duration-300 hover:-translate-y-0.5 inline-block"
      >
        Back to Home
      </a>
    </div>
  </div>
</Layout>
