---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Page Not Found">
  <div class="min-h-[70vh] flex items-center justify-center px-6">
    <div class="text-center">
      <h1 class="text-8xl font-bold text-gray-200 mb-4">404</h1>
      <p class="text-xl text-gray-600 mb-8">This page doesn't exist.</p>
      <a
        href="/"
        class="px-6 py-3 bg-gray-900 text-white rounded-lg font-medium hover:bg-gray-700 transition-all duration-300 hover:-translate-y-0.5 inline-block"
      >
        Back to Home
      </a>
    </div>
  </div>
</Layout>
