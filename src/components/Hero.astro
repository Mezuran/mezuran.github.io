---
import TypingText from './TypingText.svelte';
import ParticleBackground from './ParticleBackground.astro';
---

<section class="hero-section relative min-h-screen flex items-center justify-center px-4 sm:px-6 overflow-hidden">
  <div class="hero-gradient absolute inset-0 -z-10"></div>

  <ParticleBackground />

  <div class="floating-orb orb-1 absolute w-72 h-72 rounded-full opacity-20 blur-3xl" aria-hidden="true"></div>
  <div class="floating-orb orb-2 absolute w-96 h-96 rounded-full opacity-15 blur-3xl" aria-hidden="true"></div>
  <div class="floating-orb orb-3 absolute w-64 h-64 rounded-full opacity-10 blur-3xl" aria-hidden="true"></div>

  <div class="max-w-3xl text-center relative z-10">
    <p class="text-lg text-gray-400 mb-2 hero-greeting" data-i18n="hero.greeting">Hi, I'm Kai 👋</p>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4 hero-title">
      <span data-i18n="hero.titlePrefix">I build things for the</span>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 via-purple-400 to-pink-500">
        <TypingText
          texts={[' web.', ' terminal', ' cloud.', ' games.']}
          speed={80}
          deleteSpeed={40}
          pauseDuration={2000}
          client:load
        />
      </span>
    </h1>
    <p class="text-gray-300 text-base sm:text-lg mb-8 leading-relaxed hero-subtitle" data-i18n="hero.subtitle">
      I'm currently pursuing a Bachelor of Engineering in Informatics at Universitas Komputer Indonesia. I build web apps, tinker with DevOps infrastructure, and make games on the side.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center hero-cta">
      <a
        href="#contact"
        class="px-6 py-3 bg-white text-gray-900 rounded-lg font-medium hover:bg-gray-200 hover:shadow-lg hover:shadow-white/10 transition-all duration-300 hover:-translate-y-0.5"
        data-i18n="hero.contactMe"
      >
        Contact Me
      </a>
      <a
        href="https://www.linkedin.com/in/khaizuran-athmarrullah-8770ba38b/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 border border-gray-700 rounded-lg font-medium hover:border-white hover:shadow-lg hover:shadow-white/5 transition-all duration-300 hover:-translate-y-0.5"
        data-i18n="hero.viewLinkedIn"
      >
        View LinkedIn
      </a>
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 border border-gray-700 rounded-lg font-medium hover:border-white hover:shadow-lg hover:shadow-white/5 transition-all duration-300 hover:-translate-y-0.5 inline-flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        Resume
      </a>
    </div>
  </div>

  <div class="bounce-arrow absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  .hero-gradient {
    background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(120, 119, 198, 0.15), transparent);
  }

  .orb-1 {
    top: 10%;
    left: 20%;
    background: #818cf8;
    animation: float1 8s ease-in-out infinite;
  }

  .orb-2 {
    top: 60%;
    right: 10%;
    background: #c084fc;
    animation: float2 10s ease-in-out infinite;
  }

  .orb-3 {
    bottom: 20%;
    left: 10%;
    background: #f472b6;
    animation: float3 12s ease-in-out infinite;
  }

  @keyframes float1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -30px) scale(1.05); }
    66% { transform: translate(-20px, 20px) scale(0.95); }
  }

  @keyframes float2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-40px, 20px) scale(1.1); }
    66% { transform: translate(20px, -40px) scale(0.9); }
  }

  @keyframes float3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(20px, 30px) scale(0.95); }
    66% { transform: translate(-30px, -20px) scale(1.05); }
  }
</style>
