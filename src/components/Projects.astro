          </div>
        </div>
      </div>

      <div class="group border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden hover:shadow-lg hover:shadow-gray-900/5 dark:hover:shadow-gray-100/5 hover:-translate-y-1 transition-all duration-300 reveal flex flex-col">
