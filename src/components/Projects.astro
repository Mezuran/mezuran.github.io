<section id="projects" class="py-20 px-6">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold mb-10 text-center reveal" data-i18n="projects.title">Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 stagger-children">
      <div class="group border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden hover:shadow-lg hover:shadow-gray-900/5 dark:hover:shadow-gray-100/5 hover:-translate-y-1 transition-all duration-300 reveal flex flex-col">
        <div class="relative aspect-video bg-gray-100 dark:bg-gray-800 overflow-hidden">
          <img
            src="/projects/gor-hames.png"
            alt="GOR Hames - Badminton court booking system"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6 flex flex-col flex-1">
          <div class="flex items-start justify-between mb-3">
            <h3 class="font-semibold text-lg">GOR Hames</h3>
            <span class="text-xs px-2 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 rounded-full shrink-0 ml-2">
              <span data-i18n="projects.deployedOn">Deployed on</span> Vercel
            </span>
          </div>
          <p class="text-gray-500 dark:text-gray-400 text-sm mb-4 flex-1" data-i18n="projects.gorHamesDesc">
            Badminton court booking & management system with real-time scheduling and reservations, used by venues nationwide across Indonesia.
          </p>
          <div class="flex flex-wrap gap-1.5 mb-4">
            {['React', 'TypeScript', 'Supabase', 'Vite'].map((t) => (
              <span class="px-2 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 text-xs rounded">{t}</span>
            ))}
          </div>
          <div class="flex gap-3 pt-2 border-t border-gray-100 dark:border-gray-800">
            <a href="https://github.com/Mezuran/gor-hames" target="_blank" rel="noopener noreferrer" class="text-xs text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.0138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              <span data-i18n="projects.code">Code</span>
            </a>
            <a href="https://gor-hames.vercel.app" target="_blank" rel="noopener noreferrer" class="text-xs text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              <span data-i18n="projects.live">Live</span>
