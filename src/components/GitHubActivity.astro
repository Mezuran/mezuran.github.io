---
---

<section class="py-16 px-4 sm:px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold mb-6 text-center reveal" data-i18n="github.title">GitHub Activity</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 stagger-children">
      <div class="border border-gray-800 rounded-2xl p-5 text-center reveal hover:shadow-lg hover:shadow-white/5 hover:-translate-y-1 transition-all duration-300">
        <div class="text-3xl font-bold text-gray-100" id="github-repos">...</div>
        <div class="text-sm text-gray-400 mt-1" data-i18n="github.repos">Repositories</div>
      </div>
      <div class="border border-gray-800 rounded-2xl p-5 text-center reveal hover:shadow-lg hover:shadow-white/5 hover:-translate-y-1 transition-all duration-300" style="transition-delay: 80ms;">
        <div class="text-3xl font-bold text-gray-100" id="github-prs">...</div>
        <div class="text-sm text-gray-400 mt-1" data-i18n="github.prs">Pull Requests</div>
      </div>
      <div class="border border-gray-800 rounded-2xl p-5 text-center reveal hover:shadow-lg hover:shadow-white/5 hover:-translate-y-1 transition-all duration-300" style="transition-delay: 160ms;">
        <div class="text-3xl font-bold text-gray-100" id="github-stars">...</div>
        <div class="text-sm text-gray-400 mt-1" data-i18n="github.commits">Stars</div>
      </div>
    </div>
    <div class="mt-6 text-center reveal" style="transition-delay: 240ms;">
      <a
        href="https://github.com/Mezuran"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.0138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        <span data-i18n="github.viewOnGithub">View on GitHub</span>
      </a>
    </div>
  </div>
</section>

<script>
  async function fetchGitHubStats() {
    const username = 'Mezuran';
    try {
      const response = await fetch(`https://api.github.com/users/${username}`, {
        headers: { 'Accept': 'application/vnd.github.v3+json' }
      });
      const data = await response.json();

      const reposEl = document.getElementById('github-repos');
      const prsEl = document.getElementById('github-prs');
      const starsEl = document.getElementById('github-stars');

      if (reposEl) reposEl.textContent = String(data.public_repos ?? '...');

      const prCount = data.public_gists ?? 0;
      if (prsEl) prsEl.textContent = String(prCount || '...');

      if (starsEl) starsEl.textContent = String(data.followers ?? '...');
    } catch (e) {
      console.error('Failed to fetch GitHub stats:', e);
    }
  }

  fetchGitHubStats();
  document.addEventListener('astro:after-swap', fetchGitHubStats);
</script>
