---
---

<section id="skills" class="py-20 px-6">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold mb-10 text-center reveal" data-i18n="skills.title">Skills</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 auto-rows-min">
      <div class="bento-card col-span-1 row-span-1 border border-gray-200 rounded-2xl p-6 bg-gradient-to-br from-blue-500/10 to-blue-600/10 hover:border-blue-400/50 reveal hover:shadow-lg hover:shadow-gray-900/5 hover:-translate-y-1 transition-all duration-300">
        <h3 class="font-semibold text-lg mb-4">Languages</h3>
        <div class="flex flex-wrap gap-2">
          {['TypeScript', 'JavaScript', 'PHP', 'Python', 'Java', 'Rust'].map((skill) => (
            <span class="skill-tag px-3 py-1 bg-white/60 text-gray-700 text-sm rounded-full border border-gray-200/50">{skill}</span>
          ))}
        </div>
      </div>
      <div class="bento-card col-span-1 sm:col-span-2 row-span-1 border border-gray-200 rounded-2xl p-6 bg-gradient-to-br from-purple-500/10 to-purple-600/10 hover:border-purple-400/50 reveal hover:shadow-lg hover:shadow-gray-900/5 hover:-translate-y-1 transition-all duration-300">
        <h3 class="font-semibold text-lg mb-4">Frameworks & Runtimes</h3>
        <div class="flex flex-wrap gap-2">
          {['React', 'SolidJS', 'Next.js', 'Laravel', 'Node.js', 'React Native', 'Tauri'].map((skill) => (
            <span class="skill-tag px-3 py-1 bg-white/60 text-gray-700 text-sm rounded-full border border-gray-200/50">{skill}</span>
          ))}
        </div>
      </div>
      <div class="bento-card col-span-1 row-span-1 border border-gray-200 rounded-2xl p-6 bg-gradient-to-br from-emerald-500/10 to-emerald-600/10 hover:border-emerald-400/50 reveal hover:shadow-lg hover:shadow-gray-900/5 hover:-translate-y-1 transition-all duration-300">
        <h3 class="font-semibold text-lg mb-4">Databases</h3>
        <div class="flex flex-wrap gap-2">
          {['MySQL', 'MongoDB', 'PostgreSQL', 'SurrealDB', 'GraphQL'].map((skill) => (
            <span class="skill-tag px-3 py-1 bg-white/60 text-gray-700 text-sm rounded-full border border-gray-200/50">{skill}</span>
          ))}
        </div>
      </div>
      <div class="bento-card col-span-1 sm:col-span-2 row-span-1 border border-gray-200 rounded-2xl p-6 bg-gradient-to-br from-orange-500/10 to-orange-600/10 hover:border-orange-400/50 reveal hover:shadow-lg hover:shadow-gray-900/5 hover:-translate-y-1 transition-all duration-300">
        <h3 class="font-semibold text-lg mb-4">DevOps & Infra</h3>
        <div class="flex flex-wrap gap-2">
          {['Docker', 'Kubernetes', 'Twingate', 'NGINX', 'SSH / VPN', 'Linux', 'Windows', 'macOS'].map((skill) => (
            <span class="skill-tag px-3 py-1 bg-white/60 text-gray-700 text-sm rounded-full border border-gray-200/50">{skill}</span>
          ))}
        </div>
      </div>
      <div class="bento-card col-span-1 row-span-1 border border-gray-200 rounded-2xl p-6 bg-gradient-to-br from-pink-500/10 to-pink-600/10 hover:border-pink-400/50 reveal hover:shadow-lg hover:shadow-gray-900/5 hover:-translate-y-1 transition-all duration-300">
        <h3 class="font-semibold text-lg mb-4">Other</h3>
        <div class="flex flex-wrap gap-2">
          {['Unity', 'Supabase'].map((skill) => (
            <span class="skill-tag px-3 py-1 bg-white/60 text-gray-700 text-sm rounded-full border border-gray-200/50">{skill}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bento-card {
    backdrop-filter: blur(8px);
  }

  .skill-tag {
    transition: all 0.2s ease;
  }

  .skill-tag:hover {
    background: rgba(129, 140, 248, 0.15);
    transform: translateY(-1px);
  }
</style>
