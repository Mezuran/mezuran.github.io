---
---

<section id="experience" class="py-20 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl font-bold mb-10 reveal" data-i18n="experience.title">Experience</h2>
    <div class="space-y-8">
      <div class="border-l-2 border-gray-200 pl-6 reveal-left">
        <h3 class="text-xl font-semibold" data-i18n="experience.role">DevOps Engineer</h3>
        <p class="text-gray-500 text-sm mt-1" data-i18n="experience.company">Kementerian Pekerjaan Umum dan Perumahan Rakyat (PUPR)</p>
        <p class="text-gray-400 text-sm"><span data-i18n="experience.period">Oct 2024 – Dec 2024 · 3 months</span> · <span data-i18n="experience.location">Central Jakarta, Indonesia</span></p>
        <ul class="mt-4 space-y-2 list-disc list-inside text-gray-600">
          <li data-i18n="experience.bullet1">Deployed a website using the NGINX web engine</li>
          <li data-i18n="experience.bullet2">Migrated a large volume of data from Excel into a DBMS</li>
          <li data-i18n="experience.bullet3">Secured server access using SSH and a private VPN</li>
          <li data-i18n="experience.bullet4">Mirrored a GitHub repository to the production server</li>
        </ul>
        <div class="flex flex-wrap gap-2 mt-4">
          {['PHP', 'Laravel', 'Linux', 'Back-End Development', 'SQL'].map((skill) => (
            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 text-xs rounded">{skill}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
